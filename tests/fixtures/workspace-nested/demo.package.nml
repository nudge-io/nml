package demo:
    version = "0.1.0"
    formatVersion = 1

[]schema schemas:
    - core:
        file = "core.model.nml"

[]validator validators:
    - tenantFlows:
        files:
            - "tenants/**/*.flow.nml"
        schemas:
            - core
    - tenantPlugins:
        files:
            - "tenants/*/plugins/*/**/*.model.nml"
        schemas:
            - core
