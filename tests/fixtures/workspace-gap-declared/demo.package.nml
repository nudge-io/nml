package demo:
    version = "0.1.0"
    formatVersion = 1
    budgetUnits:
        - "tenants/*"

[]schema schemas:
    - core:
        file = "core.model.nml"

[]validator validators:
    - tenantFlows:
        files:
            - "tenants/*/flows/**/*.flow.nml"
        schemas:
            - core
