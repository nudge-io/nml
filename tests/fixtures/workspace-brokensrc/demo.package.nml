package demo:
    version = "0.1.0"
    formatVersion = 1

[]schema schemas:
    - core:
        file = "core.model.nml"
    - good:
        file = "good.model.nml"

[]validator validators:
    - tenantFlows:
        files:
            - "tenants/**/*.flow.nml"
        schemas:
            - core
        strict = true
    - docs:
        files:
            - "docs/**/*.doc.nml"
        schemas:
            - good
