// === traits ===

trait accessControlled:
    |allow []role
    |deny []role


// === enums ===

enum httpMethod:
    - "GET"
    - "POST"
    - "PUT"
    - "DELETE"
    - "PATCH"


// === models ===

model resource is accessControlled:
    path path+
    method httpMethod = "GET"

model endpoint is accessControlled:
    address string

    .healthCheck:
        path path

model service is accessControlled:
    localMount path
    resources []resource
    endpoints []endpoint
