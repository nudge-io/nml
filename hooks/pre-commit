#!/bin/sh
# Versioned pre-commit hook (enable once per clone):
#     git config core.hooksPath hooks
#
# Mirrors nudge's hook for the mistake classes that have actually redded CI
# from this workspace, cheapest first:
#
#   1. Formatting drift — CI's first job is `cargo fmt --all --check`.
#   2. A workspace that does not compile — `cargo check --locked`.
#      (Skip ONLY this step with NML_PRECOMMIT_SKIP_CHECK=1.)
#   3. Extension toolchain drift — when editors/vscode or pnpm lockfiles
#      change, `pnpm run check:toolchain` (always runs for those paths;
#      not skippable — it is cheap and prevents CI surprises).

set -e

# ── 0. RFC index integrity ──────────────────────────────────────────────────
# docs/rfcs/ is gitignored, so CI can never see it — this hook is the ONLY
# checkpoint that can. Two invariants (an 0011 number collision shipped once):
# every RFC number is unique, and every RFC has a row in the README index
# (which declares itself the authoritative status list).
if [ -d docs/rfcs ]; then
    dups=$(ls docs/rfcs | grep -E '^[0-9]{4}-' | cut -c1-4 | sort | uniq -d)
    if [ -n "$dups" ]; then
        echo "pre-commit: duplicate RFC number(s) in docs/rfcs/: $dups" >&2
        exit 1
    fi
    for f in docs/rfcs/[0-9]*.md; do
        if ! grep -qF "($(basename "$f"))" docs/rfcs/README.md; then
            echo "pre-commit: docs/rfcs/README.md has no row for $(basename "$f")" >&2
            exit 1
        fi
        if ! grep -qE '^- \*\*Status:\*\* ' "$f"; then
            echo "pre-commit: $(basename "$f") has no '- **Status:** …' header" >&2
            echo "  (the README index is authoritative; the header keeps the RFC in sync with it)" >&2
            exit 1
        fi
    done
fi

# ── 1. formatting ───────────────────────────────────────────────────────────
if ! cargo fmt --all -- --check >/dev/null 2>&1; then
    echo "pre-commit: cargo fmt --all --check failed — run 'cargo fmt --all' and re-stage." >&2
    cargo fmt --all -- --check 2>&1 | grep '^Diff in' | head -10 >&2
    exit 1
fi

# ── 2. the workspace compiles ───────────────────────────────────────────────
if [ "${NML_PRECOMMIT_SKIP_CHECK:-0}" != "1" ]; then
    if ! cargo check --workspace --quiet --locked >/dev/null 2>&1; then
        echo "pre-commit: cargo check --locked failed — a sync point must build." >&2
        echo "  (lock drift? run 'cargo update <crate>' and stage Cargo.lock)" >&2
        echo "  (emergency escape: NML_PRECOMMIT_SKIP_CHECK=1 git commit …)" >&2
        cargo check --workspace --quiet --locked 2>&1 | grep '^error' | head -5 >&2
        exit 1
    fi
fi

# ── 3. extension toolchain policy (when extension or lockfile changes) ─────
if git diff --cached --name-only | grep -qE '^(editors/vscode/|pnpm-lock\.yaml|pnpm-workspace\.yaml|package\.json|\.node-version)'; then
    if ! command -v pnpm >/dev/null 2>&1; then
        echo "pre-commit: pnpm not on PATH — install Node 22+ and run corepack enable." >&2
        exit 1
    fi
    if ! pnpm --filter nml-lang run check:toolchain >/dev/null 2>&1; then
        echo "pre-commit: extension toolchain check failed — run 'pnpm --filter nml-lang run check:toolchain'." >&2
        pnpm --filter nml-lang run check:toolchain 2>&1 | tail -8 >&2
        exit 1
    fi
fi
