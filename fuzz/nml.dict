# libFuzzer token dictionary for the NML grammar.
#
# Mutation alone reaches deep grammar states slowly: it must rediscover
# multi-byte tokens (`"""`, `->`, `$ENV.`) one lucky byte at a time. Handing
# the fuzzer the language's own vocabulary lets it splice whole tokens, so
# runs spend their budget on STRUCTURE (nesting, arms, unions, fallbacks)
# instead of on spelling keywords. libFuzzer asked for this directly — every
# run prints a "Recommended dictionary" section derived from what it had to
# discover the hard way.
#
# Keep in step with spec/syntax.md; a token that leaves the language should
# leave here too (it costs nothing but noise).

# ── declaration keywords ────────────────────────────────────────────────
"model "
"trait "
"enum "
"oneof "
"role "
"const "
"template "
"service "
"is "
"by "
"as "

# ── type names ──────────────────────────────────────────────────────────
"string"
"number"
"money"
"bool"
"duration"
"path"
"secret"
"object"
"set<"
"[]"

# ── numeric facets (RFC 0018) ───────────────────────────────────────────
"min = "
"max = "
"exclusiveMin = "
"exclusiveMax = "
"multipleOf = "

# (dict escapes are AFL-style: \\, \", \xNN — no \n shorthand)
# ── structure & operators ───────────────────────────────────────────────
":\x0a"
" = "
"- "
"->"
" | "
" & "
"?"
"+"
"#"
"("
")"
"<"
">"
","

# ── literals: strings, templates, references ────────────────────────────
"\"\"\""
"\""
"{{"
"}}"
"$ENV."
"@role/"
"@user/"
"@public"
"true"
"false"

# ── escapes (the source-character policy's sanctioned spellings) ─────────
"\\n"
"\\t"
"\\r"
"\\s"
"\\u{"
"\\\""

# ── duration units (RFC 0017 — the closed ladder) ───────────────────────
"h"
"m"
"s"
"ms"
"us"
"ns"

# ── compound durations (RFC 0017 §10) ───────────────────────────────────
"1h30m"
"5m2s"
"1h2h"
"1h30"

# ── digit separators & numeric shapes (RFC 0016) ────────────────────────
"_"
"0."
"1_000"
"e-"
"e+"

# ── currency codes (ISO 4217 — a representative spread of exponents) ────
"USD"
"JPY"
"BHD"
"CLF"

# ── comments & directives ───────────────────────────────────────────────
"// "
"#live"
"#restart"

# ── hostile characters (source-character policy) ────────────────────────
# Raw bytes the policy must diagnose, never pass or mangle. U+E0067
# (TAG LATIN SMALL LETTER G): the invisible-ASCII tag block.
"\xf3\xa0\x81\xa7"
# U+FEFF raw (interior BOM), U+202E (RLO bidi), U+0085 (NEL), U+2028 (LS)
"\xef\xbb\xbf"
"\xe2\x80\xae"
"\xc2\x85"
"\xe2\x80\xa8"
# Private-use sentinels U+E000/U+E00F: the remove-judgment's marker
# range — values already holding them steer the sentinel picker (and
# all-16-present is its fail-closed refusal).
"\xee\x80\x80"
"\xee\x80\x8f"
# Quote runs: the delete-splice relex corners (quote-merge shapes).
"\"\""
"\"\"\""
"\"\"\"\""
