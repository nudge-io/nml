// Skylight's schema — Chapter 8.
// Directives declare each field's reload semantics: `#live` changes apply
// to a running process; everything else means restart (our conservative
// default). The schema states policy; the program in app/ enforces it.

enum logLevel:
    - "debug"
    - "info"
    - "warn"
    - "error"

trait accessControlled:
    |allow []role?
    |deny []role?

model role:
    label string?
    description string?
    members []role?

trait monitored:
    checkInterval duration = "60s"
    timeout duration = "5s"

model database:
    url string
    poolSize number = 10

model endpoint is monitored, accessControlled:
    url string+
    healthPath path = "/health"
    regions set<string>?

model notifierLog:
    level logLevel = "warn"

model notifierEmail:
    from string
    to string
    serverToken secret

model notifierWebhook:
    url string
    signingSecret secret?

oneof notifier by kind = "log":
    "log"     -> notifierLog
    "email"   -> notifierEmail
    "webhook" -> notifierWebhook

model service is accessControlled:
    host string #restart
    port number #restart
    publicUrl string
    logLevel logLevel = "info" #live
    requestTimeout duration = "30s" #live
    retries number = 3 #live
    banner string? #live
    welcome string? #live
    tags []string
    apiKey secret #live
    database database #restart
    endpoints []endpoint #live
    notifiers []notifier #live
    maintenanceContact (string | []string)? #live
    landing (string | (role -> string))? #live

model plan:
    name string
    monthlyPrice money
    annualPrice money?
    trialDays number = 14
